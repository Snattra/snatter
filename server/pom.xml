<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>app.snatter</groupId>
    <artifactId>snatter-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>
    <name>Snatter Server</name>
    <description>Self-hosted voice and text communication server</description>
    <url>https://snatter.app</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
        </license>
    </licenses>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <!-- Language level is capped at the current LTS because GraalVM/Mandrel,
             which build the native executable, only exist for LTS releases.
             The JVM build runs happily on newer JDKs. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.39.4</quarkus.platform.version>
        <quarkus-jdbi.version>1.10.1</quarkus-jdbi.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <ice4j.version>3.2-21-g3d9cdaa</ice4j.version>
        <!-- The hand-written OpenAPI document in the Apache-licensed protocol
             module is the API contract. Server interfaces and DTOs are
             generated from it on every build. -->
        <openapi.spec>${project.basedir}/../protocol/openapi/openapi.yaml</openapi.spec>
        <openapi-generator.version>7.25.0</openapi-generator.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-narayana-jta</artifactId>
        </dependency>
        <!-- Plain driver rather than a Quarkus extension: it supports native
             images by itself and bundles SQLite for every major platform. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.jdbi</groupId>
            <artifactId>quarkus-jdbi</artifactId>
            <version>${quarkus-jdbi.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!-- Voice media: ICE from Jitsi's ice4j. See docs/development.md. -->
        <dependency>
            <groupId>org.jitsi</groupId>
            <artifactId>ice4j</artifactId>
            <version>${ice4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The HTTP client of the generated test client. -->
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${openapi.spec}</inputSpec>
                            <generatorName>jaxrs-spec</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>app.snatter.api</apiPackage>
                            <modelPackage>app.snatter.api.model</modelPackage>
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <!-- Keep a oneOf with a single option a union, so it stays a sealed
                                 interface that later options can join. -->
                            <openapiNormalizer>SIMPLIFY_ONEOF_ANYOF=false</openapiNormalizer>
                            <schemaMappings>
                                <!-- Typed ids are hand-written value records, not generated. -->
                                <schemaMapping>AccountId=AccountId</schemaMapping>
                                <schemaMapping>BlobId=BlobId</schemaMapping>
                                <schemaMapping>InviteCode=InviteCode</schemaMapping>
                                <schemaMapping>RoleId=RoleId</schemaMapping>
                                <schemaMapping>ChannelId=ChannelId</schemaMapping>
                                <schemaMapping>MessageId=MessageId</schemaMapping>
                            </schemaMappings>
                            <typeMappings>
                                <typeMapping>DateTime=Instant</typeMapping>
                                <!-- Raw request and response bodies are streamed. -->
                                <typeMapping>file=InputStream</typeMapping>
                                <typeMapping>binary=InputStream</typeMapping>
                            </typeMappings>
                            <importMappings>
                                <importMapping>Instant=java.time.Instant</importMapping>
                                <importMapping>InputStream=java.io.InputStream</importMapping>
                                <importMapping>AccountId=app.snatter.server.account.AccountId</importMapping>
                                <importMapping>BlobId=app.snatter.server.blob.BlobId</importMapping>
                                <importMapping>InviteCode=app.snatter.server.invite.InviteCode</importMapping>
                                <importMapping>RoleId=app.snatter.server.role.RoleId</importMapping>
                                <importMapping>ChannelId=app.snatter.server.channel.ChannelId</importMapping>
                                <importMapping>MessageId=app.snatter.server.message.MessageId</importMapping>
                            </importMappings>
                            <configOptions>
                                <library>quarkus</library>
                                <interfaceOnly>true</interfaceOnly>
                                <!-- Typed responses: RestResponse<Dto> keeps the body type checked
                                     while leaving status and headers under our control. -->
                                <returnJBossResponse>true</returnJBossResponse>
                                <useTags>true</useTags>
                                <useJakartaEe>true</useJakartaEe>
                                <useBeanValidation>true</useBeanValidation>
                                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                <useMicroProfileOpenAPIAnnotations>false</useMicroProfileOpenAPIAnnotations>
                                <openApiNullable>false</openApiNullable>
                                <!-- Absent arrays must arrive as null so partial updates can tell
                                     "unchanged" from "set to empty". -->
                                <containerDefaultToNull>true</containerDefaultToNull>
                                <!-- oneOf with a discriminator becomes a sealed interface with final
                                     implementations, so Java code can switch over it exhaustively. -->
                                <useOneOfInterfaces>true</useOneOfInterfaces>
                                <useSealed>true</useSealed>
                                <dateLibrary>java8</dateLibrary>
                                <!-- Response DTOs travel inside Response.entity(), where Quarkus
                                     cannot see them, so register every model for native reflection.
                                     Enums too: without it, one only the gateway sends (such as
                                     PresenceStatusDto) serialises by its Java name, "ONLINE". -->
                                <additionalModelTypeAnnotations>@io.quarkus.runtime.annotations.RegisterForReflection</additionalModelTypeAnnotations>
                                <additionalEnumTypeAnnotations>@io.quarkus.runtime.annotations.RegisterForReflection</additionalEnumTypeAnnotations>
                                <additionalOneOfTypeAnnotations>@io.quarkus.runtime.annotations.RegisterForReflection</additionalOneOfTypeAnnotations>
                                <generatePom>false</generatePom>
                                <sourceFolder>src/main/java</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- A client for the tests, from the same contract, so they call the API
                             through typed operations and models instead of paths and raw JSON.
                             It is test source only and never part of the application. -->
                        <id>generate-test-client</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${openapi.spec}</inputSpec>
                            <generatorName>java</generatorName>
                            <!-- Not the default native client: it turns a oneOf into a wrapper
                                 that tries each option in turn, where this one makes an interface
                                 Jackson resolves by the discriminator. -->
                            <library>apache-httpclient</library>
                            <output>${project.build.directory}/generated-test-sources/openapi</output>
                            <addCompileSourceRoot>false</addCompileSourceRoot>
                            <addTestCompileSourceRoot>true</addTestCompileSourceRoot>
                            <invokerPackage>app.snatter.client</invokerPackage>
                            <apiPackage>app.snatter.client.api</apiPackage>
                            <modelPackage>app.snatter.client.model</modelPackage>
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <openapiNormalizer>SIMPLIFY_ONEOF_ANYOF=false</openapiNormalizer>
                            <typeMappings>
                                <typeMapping>DateTime=Instant</typeMapping>
                            </typeMappings>
                            <importMappings>
                                <importMapping>Instant=java.time.Instant</importMapping>
                            </importMappings>
                            <configOptions>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <!-- Absent arrays stay null and are left out of requests, so a
                                     partial update does not empty them. -->
                                <containerDefaultToNull>true</containerDefaultToNull>
                                <!-- Failed calls throw an unchecked ApiException, so tests need no
                                     throws clauses. -->
                                <useRuntimeException>true</useRuntimeException>
                                <useOneOfInterfaces>true</useOneOfInterfaces>
                                <!-- Query parameters are all simple values. Models that hold a oneOf
                                     interface would not compile with this on, as the interface lacks
                                     the toUrlQueryString it generates. -->
                                <supportUrlQuery>false</supportUrlQuery>
                                <dateLibrary>java8</dateLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Serve the contract itself at /q/openapi (and Swagger UI in dev). -->
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-openapi-spec</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../protocol/openapi</directory>
                                    <includes>
                                        <include>openapi.yaml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <java.awt.headless>true</java.awt.headless>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
