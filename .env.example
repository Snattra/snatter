# Copy to .env and adjust. Read by docker compose; compose.yaml says more.

# The address members reach this machine at: a host name pointing here, or
# the machine's public IP address. With it, the app is served over HTTPS,
# which voice in a browser needs; ports 80 and 443 of that address must reach
# SNATTER_HTTP_PORT and SNATTER_HTTPS_PORT here, such as by forwarding them
# on the router. Without it, plain HTTP.
#SNATTER_ADDRESS=chat.example.com

# This machine's ports for HTTP and HTTPS.
SNATTER_HTTP_PORT=8080
SNATTER_HTTPS_PORT=8443

# The address voice reaches this machine at, when it is not SNATTER_ADDRESS:
# its LAN address, say, when members are on the same network. Without either,
# the server offers only its container's addresses, which browsers usually
# cannot reach.
#SNATTER_MEDIA_ADDRESS=192.168.1.10
