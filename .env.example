# Copy to .env and adjust. Read by docker compose.

# Host port the web app, and the API behind it, are published on.
SNATTER_HTTP_PORT=8080

# The address browsers reach this machine at, for voice: its LAN address, or
# its public one. Without it, the server offers only its container's
# addresses, which browsers usually cannot reach.
#SNATTER_MEDIA_ADDRESS=192.168.1.10
