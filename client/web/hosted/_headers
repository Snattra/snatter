# The response headers of the hosted app at web.snatter.app, in the format
# Cloudflare Pages reads (and Netlify too). The multi-server build copies this
# file into its output, and puts the Content-Security-Policy below in the page
# as well, for hosts that cannot set headers; see vite.config.ts.
#
# The policy is the server installation's (caddy/Caddyfile), but
# this app talks to servers of anyone's choosing: any HTTPS server and its
# gateway, and servers on this machine, for development: those the app
# takes as local (isLocal in src/state/serverAddress.ts), and no others.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https: http://localhost:* http://*.localhost:* http://127.0.0.1:*; font-src 'self'; connect-src 'self' https: wss: http://localhost:* ws://localhost:* http://*.localhost:* ws://*.localhost:* http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types snatter
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=()

# Named by content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
