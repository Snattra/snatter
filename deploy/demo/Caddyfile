# HTTPS for SNATTER_DOMAIN, with a certificate from Let's Encrypt that Caddy
# gets and renews by itself.

{$SNATTER_DOMAIN} {
	# The API and the gateway, for the app at web.snatter.app and others.
	handle /api/* {
		reverse_proxy server:8080
	}

	# Invite links as the server makes them, /invite/{code}, go on to the
	# app with this server named, /invite#{server}/{code}, so that it adds
	# the server and signs up with the invite.
	handle /invite/* {
		redir "https://web.snatter.app/invite#{host}/{http.request.uri.path.1}" 302
	}

	# The app itself is at web.snatter.app, which can add this server.
	handle {
		redir https://web.snatter.app 302
	}
}
